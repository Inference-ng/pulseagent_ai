
# ─── LLM Provider (choose one) ────────────────────────────────
# Option 1: Google Gemini (paid, best quality)
GOOGLE_API_KEY=your_gemini_api_key_here

# Option 2: Ollama (free, runs locally — recommended for hackathon)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ─── Backend ──────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./pulseagent.db
# For PostgreSQL (optional):
# DATABASE_URL=postgresql+asyncpg://postgres:password@db:5432/pulseagent
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# ─── Frontend ─────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:8000
VITE_RUN_MODE=mock