// PulseAgent AI — Prisma Schema (Phase 2)
// Database: SQLite (local)

datasource db {
  provider = "sqlite"
  url      = "file:./pulseagent.db"
}

generator client {
  provider = "prisma-client-py"
}

// ===================================================================
// MODELS
// ===================================================================

/// User Profile — stores user personas and history
model User {
  id            String   @id @default(cuid())
  user_id       String   @unique
  name          String?
  metadata      String?
  createdAt     DateTime @default(now())
  
  // Relations
  simulations   Simulation[]
  recommendations Recommendation[]

  @@index([user_id])
  @@map("users")
}

/// Simulation Result — stores Task A outputs
model Simulation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  productName     String
  productData     String     // Full product details (JSON string)
  
  predictedRating Float    // 1-5
  simulatedReview String
  confidence      Float    // 0-1
  reasoning       String
  
  createdAt       DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
  @@map("simulations")
}

/// Recommendation Result — stores Task B outputs
model Recommendation {
  id                String   @id @default(cuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  recommendationsJson String   // Array of recommendation items (JSON string)
  isColdStart       Boolean
  domain            String   // fashion, electronics, books, food
  
  createdAt         DateTime @default(now())

  @@index([userId])
  @@index([domain])
  @@index([createdAt])
  @@map("recommendations")
}

/// Audit Log — tracks all API requests
model AuditLog {
  id        String   @id @default(cuid())
  endpoint  String
  method    String
  status    Int
  duration  Int       // milliseconds
  error     String?
  timestamp DateTime @default(now())

  @@index([endpoint])
  @@index([timestamp])
  @@map("audit_logs")
}
