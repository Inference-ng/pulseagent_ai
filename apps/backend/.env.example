# ── Database ──────────────────────────────────────────────────────────────────
# Use RDS PostgreSQL on AWS (or keep Neon for the hackathon demo)
DATABASE_URL=postgresql://user:password@your-rds-endpoint.amazonaws.com/pulseagent

# ── AI & LLM ──────────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_S3_BUCKET=your-pulseagent-bucket
AWS_S3_PREFIX=faiss/
AWS_DEFAULT_REGION=us-east-1
# Not needed if using ECS IAM Task Role (recommended):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Search mode ───────────────────────────────────────────────────────────────
DISABLE_NEURAL_SEARCH=0

# ── FAISS data path ───────────────────────────────────────────────────────────
# Path inside the container where artifacts will be downloaded from S3
FAISS_DATA_DIR=/app/data/processed

# ── Backend settings ──────────────────────────────────────────────────────────
SECRET_KEY=change-this-in-production
ENVIRONMENT=production
DEBUG=false

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://pulseagent-ai.vercel.app
