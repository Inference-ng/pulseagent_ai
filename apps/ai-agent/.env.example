# ── LLM API Keys ─────────────────────────────────────────────────────────────
GOOGLE_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY_2=your_second_gemini_api_key_here

# Groq (free, very fast — sign up at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# OpenRouter (free tier available — https://openrouter.ai)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── AWS ───────────────────────────────────────────────────────────────────────
# S3 bucket that holds the FAISS artifacts (items.index, items_metadata.pkl, tfidf_model.pkl)
# FAISSStore downloads them automatically at startup if they are missing locally.
AWS_S3_BUCKET=your-pulseagent-bucket
AWS_S3_PREFIX=faiss/
AWS_DEFAULT_REGION=us-east-1

# If running on ECS with an IAM Task Role, you do NOT need to set these:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ── Search mode ───────────────────────────────────────────────────────────────
# Set to 1 only on very memory-constrained instances (< 1 GB RAM).
# AWS ECS tasks with >= 2 GB memory can run neural search fine.
DISABLE_NEURAL_SEARCH=0
